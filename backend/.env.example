# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173   # comma-separated list of frontend origins

# --- Dental office context (used in prompts / FAQ fallback) ---
OFFICE_NAME="Chairside Dental"
OFFICE_TIMEZONE=America/New_York
OFFICE_PHONE="+15555550123"

# --- LLM provider switch ---
# One of: groq | anthropic | openai
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Retell AI ---
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=

# --- Cal.com ---
CALCOM_API_KEY=
CALCOM_API_BASE_URL=https://api.cal.com/v2
CALCOM_EVENT_TYPE_ID=

# --- HubSpot (free tier private app) ---
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_BASE_URL=https://api.hubapi.com

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Supabase / Postgres ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (Supabase project settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Local demo ---
# When true, Cal.com/HubSpot/Twilio tool calls return fake data instead of
# hitting those providers -- lets the full booking flow run without those
# accounts. Set to false once real credentials above are filled in.
TOOLS_MOCK_MODE=true
